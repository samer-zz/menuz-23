# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application Base URL (used for SEO, Sitemap, QR generation)
NEXT_PUBLIC_SITE_URL=https://your-deployment.vercel.app

# Cron Secret for keep-alive / scheduled maintenance
CRON_SECRET=your-random-cron-secret

# Web Push (VAPID) Keys — generate via `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@menuz.app

